---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
---

<BaseLayout title={post.data.title} description={post.data.title} ogType="article">
  <article class="article-container">
    <header class="article-header">
      <div class="article-breadcrumb">
        <span class="path-symbol">&#128193;</span>
        <a href="/" class="path-link">blog</a>
        <span class="path-slash">/</span>
        <span class="path-current">{post.id}.md</span>
      </div>

      <div class="article-meta">
        <span class="meta-item">
          <span class="meta-label">date:</span>
          <time datetime={post.data.date.toISOString()} class="date-val">
            {formatDate(post.data.date)}
          </time>
        </span>
      </div>

      <h1 class="article-title">{post.data.title}</h1>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="article-tags">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} class="tag-badge">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="article-footer">
      <div class="footer-signoff">
        <span class="prompt-char">$</span> <span class="signoff-text">exit 0</span>
      </div>
      <a href="/" class="back-link">
        <span class="back-cmd">&larr; cd ..</span>
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2.25rem 2.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .article-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .article-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .path-symbol {
    font-size: 0.85rem;
  }

  .path-link {
    color: var(--accent-primary);
  }

  .path-slash {
    color: var(--border-color);
  }

  .path-current {
    color: var(--text-secondary);
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .meta-label {
    color: var(--text-muted);
    margin-right: 0.35rem;
  }

  .date-val {
    color: var(--accent-success);
    font-weight: 500;
  }

  .article-title {
    font-family: var(--font-mono);
    font-size: 1.85rem;
    line-height: 1.35;
    color: var(--accent-warning);
    margin-bottom: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
  }

  .footer-signoff {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .signoff-text {
    color: var(--accent-success);
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--accent-primary);
    padding: 0.35rem 0.8rem;
    background: rgba(88, 166, 255, 0.08);
    border: 1px solid rgba(88, 166, 255, 0.25);
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .back-link:hover {
    background: rgba(88, 166, 255, 0.18);
    border-color: var(--accent-primary);
    color: #ffffff;
    transform: translateX(-3px);
  }

  @media (max-width: 640px) {
    .article-container {
      padding: 1.25rem 1rem;
    }

    .article-title {
      font-size: 1.45rem;
    }

    .article-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>
