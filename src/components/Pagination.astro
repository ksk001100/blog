---
interface Props {
  currentPage: number;
  lastPage: number;
  basePath?: string;
}

const { currentPage, lastPage, basePath = '/page' } = Astro.props;

function getPageUrl(pageNum: number): string {
  if (pageNum === 1) return '/';
  return `${basePath}/${pageNum}`;
}

const pages = Array.from({ length: lastPage }, (_, i) => i + 1);
---

{lastPage > 1 && (
  <nav class="pagination-nav" aria-label="ページネーション">
    <div class="pager-cli-prefix">
      <span class="prompt-char">$</span>
      <span class="cmd-text">pager</span>
      <span class="page-indicator">--page={currentPage}/{lastPage}</span>
    </div>

    <div class="pager-buttons">
      {currentPage > 1 ? (
        <a href={getPageUrl(currentPage - 1)} class="page-button page-nav-btn">
          &lt; prev
        </a>
      ) : (
        <span class="page-button disabled page-nav-btn">&lt; prev</span>
      )}

      <div class="page-numbers">
        {pages.map((p) => (
          p === currentPage ? (
            <span class="page-button current" aria-current="page">
              <span class="num-bracket">[</span>{p}<span class="num-bracket">]</span>
            </span>
          ) : (
            <a href={getPageUrl(p)} class="page-button">
              {p}
            </a>
          )
        ))}
      </div>

      {currentPage < lastPage ? (
        <a href={getPageUrl(currentPage + 1)} class="page-button page-nav-btn">
          next &gt;
        </a>
      ) : (
        <span class="page-button disabled page-nav-btn">next &gt;</span>
      )}
    </div>
  </nav>
)}

<style>
  .pagination-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono);
  }

  .pager-cli-prefix {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cmd-text {
    color: var(--accent-success);
    font-weight: 600;
  }

  .page-indicator {
    color: var(--accent-primary);
  }

  .pager-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .page-numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0.4rem;
  }

  .page-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    height: 2.2rem;
    padding: 0 0.5rem;
    border-radius: 4px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.86rem;
    font-family: var(--font-mono);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .page-nav-btn {
    padding: 0 0.75rem;
    font-weight: 500;
  }

  .page-button:hover:not(.disabled):not(.current) {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background-color: rgba(88, 166, 255, 0.08);
  }

  .page-button.current {
    background-color: rgba(88, 166, 255, 0.15);
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    font-weight: 700;
  }

  .num-bracket {
    color: var(--accent-warning);
  }

  .page-button.disabled {
    opacity: 0.3;
    cursor: not-allowed;
    background-color: transparent;
    border-color: var(--border-subtle);
  }
</style>
