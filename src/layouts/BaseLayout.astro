---
interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = "ksk's tech blog",
  description = "ksk's tech blog.",
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = "ksk's tech blog";
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: JetBrains Mono & Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300..800;1,300..800&family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon/android-chrome-192x192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/favicon/android-chrome-512x512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="ksk's tech blog" href="/rss.xml" />

    <!-- OGP -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content="https://ksk.works/favicon/android-chrome-512x512.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DC7MYT5DHQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-DC7MYT5DHQ');
    </script>
  </head>
  <body>
    <div class="layout-container">
      <header class="site-header">
        <div class="header-banner">
          <div class="terminal-prompt">
            <a href="/" class="site-logo">
              <span class="prompt-host">ksk@works</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-char">$</span>
              <span class="site-name">blog</span>
              <span class="cursor-blink">_</span>
            </a>
          </div>
          <div class="system-badge">
            <span class="status-dot"></span>
            <span class="status-text">ONLINE</span>
          </div>
        </div>

        <nav class="site-nav">
          <ul class="nav-list">
            <li><a href="/" class="nav-link"><span class="nav-symbol">&gt;</span> blog</a></li>
            <li><a href="/tags" class="nav-link"><span class="nav-symbol">&gt;</span> tags</a></li>
            <li><a href="/about" class="nav-link"><span class="nav-symbol">&gt;</span> about</a></li>
            <li><a href="/privacy" class="nav-link"><span class="nav-symbol">&gt;</span> privacy</a></li>
            <li class="nav-divider">/</li>
            <li><a href="https://github.com/ksk001100" target="_blank" rel="noopener noreferrer" class="nav-link ext">github <span class="ext-icon">&#8599;</span></a></li>
            <li><a href="https://twitter.com/ksk001100" target="_blank" rel="noopener noreferrer" class="nav-link ext">x <span class="ext-icon">&#8599;</span></a></li>
            <li><a href="https://bsky.app/profile/ksk.works" target="_blank" rel="noopener noreferrer" class="nav-link ext">bluesky <span class="ext-icon">&#8599;</span></a></li>
            <li><a href="https://lapras.com/public/ksk" target="_blank" rel="noopener noreferrer" class="nav-link ext">lapras <span class="ext-icon">&#8599;</span></a></li>
          </ul>
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-cmd">
          <span class="prompt-char">$</span> <span class="cmd-text">echo "Happy Hacking!"</span>
        </div>
        <div class="footer-meta">
          <span>branch: <strong>main</strong></span>
          <span class="footer-sep">&bull;</span>
          <span>&copy; {new Date().getFullYear()} Keisuke Toyota</span>
        </div>
      </footer>
    </div>

    <!-- Code Block Header & Copy Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.prose pre').forEach((pre) => {
          if (pre.parentElement && pre.parentElement.classList.contains('code-block-wrapper')) {
            return;
          }

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';

          const header = document.createElement('div');
          header.className = 'code-block-header';

          const dots = document.createElement('div');
          dots.className = 'window-dots';
          dots.innerHTML = '<span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>';

          const lang = pre.getAttribute('data-language') || 'code';
          const langBadge = document.createElement('span');
          langBadge.className = 'code-lang';
          langBadge.textContent = lang.toLowerCase();

          const copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'code-copy-btn';
          copyBtn.title = 'Copy code';
          copyBtn.innerHTML = `
            <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="btn-text">copy</span>
          `;

          copyBtn.addEventListener('click', async () => {
            const codeText = pre.querySelector('code')?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(codeText);
              copyBtn.classList.add('copied');
              copyBtn.querySelector('.btn-text').textContent = 'copied!';
              setTimeout(() => {
                copyBtn.classList.remove('copied');
                copyBtn.querySelector('.btn-text').textContent = 'copy';
              }, 2000);
            } catch (err) {
              console.error('Failed to copy', err);
            }
          });

          header.appendChild(dots);
          header.appendChild(langBadge);
          header.appendChild(copyBtn);

          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(header);
          wrapper.appendChild(pre);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #0d1117;
    --bg-surface: #161b22;
    --bg-elevated: #1f242c;
    --border-color: #30363d;
    --border-subtle: #21262d;
    
    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
    --text-muted: #6e7681;
    
    --accent-primary: #58a6ff;     /* Cyan / Blue */
    --accent-success: #3fb950;     /* Terminal Green */
    --accent-warning: #e3b341;     /* Amber / Yellow */
    --accent-highlight: #bc8cff;   /* Neon Purple */
    --accent-code: #79c0ff;
    
    --font-mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    --font-body: 'JetBrains Mono', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    
    --grid-dot-color: rgba(255, 255, 255, 0.04);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
  }

  html, body {
    background-color: var(--bg-color);
    background-image: radial-gradient(var(--grid-dot-color) 1px, transparent 1px);
    background-size: 24px 24px;
    color: var(--text-primary);
    font-family: var(--font-body);
    line-height: 1.75;
    font-size: 15.5px;
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 7px;
    height: 7px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg-color);
  }
  ::-webkit-scrollbar-thumb {
    background: #30363d;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #484f58;
  }

  /* Text Selection */
  ::selection {
    background-color: rgba(88, 166, 255, 0.28);
    color: #ffffff;
  }

  a {
    color: var(--accent-primary);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  a:hover {
    color: #79c0ff;
    text-decoration: none;
  }

  .layout-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Site Header */
  .site-header {
    margin-bottom: 3rem;
    border: 1px solid var(--border-color);
    background-color: rgba(22, 27, 34, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .header-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .terminal-prompt {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-primary);
  }

  .site-logo:hover {
    color: var(--text-primary);
  }

  .prompt-host {
    color: var(--accent-success);
  }

  .prompt-colon {
    color: var(--text-secondary);
  }

  .prompt-path {
    color: var(--accent-primary);
  }

  .prompt-char {
    color: var(--accent-warning);
    font-weight: 700;
  }

  .site-name {
    margin-left: 0.3rem;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .cursor-blink {
    color: var(--accent-success);
    font-weight: 700;
    animation: blink 1s step-start infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .system-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    background: rgba(63, 185, 80, 0.1);
    border: 1px solid rgba(63, 185, 80, 0.3);
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-success);
    box-shadow: 0 0 8px var(--accent-success);
  }

  .status-text {
    color: var(--accent-success);
    font-weight: 600;
  }

  /* Nav */
  .site-nav {
    font-family: var(--font-mono);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    list-style: none;
    font-size: 0.9rem;
  }

  .nav-link {
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .nav-symbol {
    color: var(--accent-primary);
    opacity: 0.6;
    font-weight: 700;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link:hover .nav-symbol {
    opacity: 1;
  }

  .nav-divider {
    color: var(--border-color);
    font-size: 0.8rem;
    user-select: none;
  }

  .nav-link.ext {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .nav-link.ext:hover {
    color: var(--accent-primary);
  }

  .ext-icon {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* Main */
  .site-main {
    flex: 1;
  }

  /* Footer */
  .site-footer {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-cmd {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
  }

  .footer-cmd .cmd-text {
    color: var(--accent-success);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-meta strong {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .footer-sep {
    color: var(--border-color);
  }

  /* Tag Badge (Global) */
  .tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    background-color: rgba(88, 166, 255, 0.08);
    color: var(--accent-primary);
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    border: 1px solid rgba(88, 166, 255, 0.2);
    transition: all 0.15s ease;
  }

  .tag-badge:hover {
    background-color: rgba(88, 166, 255, 0.18);
    border-color: var(--accent-primary);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Code Block Wrapper & Window Header */
  .code-block-wrapper {
    margin: 1.75rem 0;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: #0b0e14;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    user-select: none;
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .window-dots .dot.red { background-color: #f85149; }
  .window-dots .dot.yellow { background-color: #d29922; }
  .window-dots .dot.green { background-color: #3fb950; }

  .code-lang {
    font-weight: 600;
    text-transform: lowercase;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  .code-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .code-copy-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    border-color: var(--accent-primary);
  }

  .code-copy-btn.copied {
    border-color: var(--accent-success);
    color: var(--accent-success);
    background: rgba(63, 185, 80, 0.12);
  }

  /* Prose / Article Typography */
  .prose {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .prose h1, .prose h2, .prose h3, .prose h4 {
    font-family: var(--font-mono);
    color: var(--accent-warning);
    margin-top: 2.2rem;
    margin-bottom: 1rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .prose h1 {
    font-size: 1.7rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .prose h2 {
    font-size: 1.38rem;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 0.4rem;
    color: #ffa657;
  }

  .prose h3 {
    font-size: 1.18rem;
    color: #e3b341;
  }

  .prose h4 {
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.6rem;
  }

  .prose li {
    margin-bottom: 0.45rem;
  }

  .prose li::marker {
    color: var(--accent-primary);
    font-family: var(--font-mono);
  }

  .prose blockquote {
    border-left: 3px solid var(--accent-primary);
    margin: 1.6rem 0;
    padding: 0.75rem 1.1rem;
    color: #c9d1d9;
    background: rgba(88, 166, 255, 0.05);
    border-radius: 0 6px 6px 0;
    font-style: italic;
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose code:not(pre code) {
    background-color: rgba(110, 118, 129, 0.2);
    color: var(--accent-highlight);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .code-block-wrapper pre,
  .prose pre {
    margin: 0 !important;
    padding: 1.1rem 1.25rem !important;
    border: none !important;
    border-radius: 0 0 8px 8px !important;
    font-family: var(--font-mono) !important;
    font-size: 0.92rem;
    line-height: 1.55;
    overflow-x: auto;
  }

  .code-block-wrapper pre code {
    font-family: var(--font-mono) !important;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.75rem auto;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95rem;
    font-family: var(--font-mono);
  }

  .prose th, .prose td {
    border: 1px solid var(--border-color);
    padding: 0.65rem 0.9rem;
    text-align: left;
  }

  .prose th {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 600;
  }

  .prose tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.015);
  }

  .prose hr {
    border: none;
    border-top: 1px dashed var(--border-color);
    margin: 2.5rem 0;
  }

  kbd {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    box-shadow: inset 0 -1px 0 var(--border-color);
  }

  @media (max-width: 640px) {
    .layout-container {
      padding: 1.5rem 1rem 3rem;
    }

    .site-header {
      padding: 1rem;
    }

    .header-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .terminal-prompt {
      font-size: 1rem;
    }

    .prose {
      font-size: 0.98rem;
    }
  }
</style>
